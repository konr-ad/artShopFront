diff --git a/Dockerfile b/Dockerfile
new file mode 100644
index 0000000..2222222
--- /dev/null
+++ b/Dockerfile
@@ -0,0 +1,60 @@
+# ---------- STAGE 1: build ----------
+FROM node:20-alpine AS build
+WORKDIR /app
+
+# Zależności
+COPY package*.json ./
+RUN npm ci
+
+# Reszta źródeł
+COPY . .
+
+# Build produkcyjny
+# Ustalony output-path, by łatwo kopiować do obrazu nginx
+RUN npm run build -- --configuration=production --output-path=dist/app
+
+# ---------- STAGE 2: serve ----------
+FROM nginx:alpine
+
+# Nginx conf dopasowany do SPA (Angular)
+COPY nginx.conf /etc/nginx/conf.d/default.conf
+
+# Skopiuj zbudowany frontend
+COPY --from=build /app/dist/app/ /usr/share/nginx/html/
+
+# (Opcjonalnie) nie-root user byłby mile widziany, ale nginx:alpine ma własną konfigurację użytkownika.
+# EXPOSE dla dokumentacji
+EXPOSE 80
+
+# Domyślny CMD obrazu nginx
+
+# Użycie:
+# docker build -t artshopfront:prod .
+# docker run -p 8080:80 artshopfront:prod
diff --git a/nginx.conf b/nginx.conf
new file mode 100644
index 0000000..3333333
--- /dev/null
+++ b/nginx.conf
@@ -0,0 +1,73 @@
+server {
+  listen 80;
+  server_name _;
+
+  root /usr/share/nginx/html;
+  index index.html;
+
+  # Routing SPA – wszystkie nieistniejące ścieżki do index.html
+  location / {
+    try_files $uri $uri/ /index.html;
+  }
+
+  # Cache dla statyków z fingerprintem (Angular generuje z hashami)
+  location ~* \.(?:js|mjs|css|woff2?|svg|png|jpg|jpeg|gif|webp)$ {
+    expires 30d;
+    add_header Cache-Control "public, max-age=2592000, immutable";
+  }
+
+  # Gzip (lekka kompresja)
+  gzip on;
+  gzip_types text/plain text/css application/json application/javascript application/x-javascript text/xml application/xml application/xml+rss image/svg+xml;
+  gzip_min_length 1024;
+
+  # Podstawowe nagłówki bezpieczeństwa (CSP zostaw w trybie report-only, jeśli będziesz dodawać)
+  add_header X-Content-Type-Options "nosniff" always;
+  add_header X-Frame-Options "DENY" always;
+  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
+  # Przykład CSP (NAJPIERW testuj w Report-Only):
+  # add_header Content-Security-Policy "default-src 'self';" always;
+}
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
